---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/site.css';
---

<Layout
  title="Company Login — StarterCulture"
  description="StarterCulture team login."
>
  <Header links={[{ href: '/', label: 'Home' }]} />

  <main class="auth-main">
    <div class="login-card">
      <div class="lock-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#B5482B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="4" y="10" width="16" height="10" rx="2"/>
          <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
        </svg>
      </div>
      <h1>Company Login</h1>
      <p class="sub">StarterCulture team members: sign in with your email to reach the admin area.</p>

      <div id="step-email">
        <p id="email-error" class="form-error" hidden></p>
        <form id="company-login-form" novalidate>
          <div class="field">
            <label for="company-email">Email</label>
            <input type="email" id="company-email" name="company-email" placeholder="you@starterculturestudio.com" autocomplete="email" required />
          </div>
          <button type="submit">Send sign-in link</button>
        </form>
      </div>

      <div id="step-sent" hidden>
        <p class="otp-note">If that's a recognized team email, we've sent a sign-in link to it. Click the link in that email to continue.</p>
        <button type="button" id="email-back" class="link-btn">&larr; Use a different email</button>
      </div>

      <div id="step-confirm" hidden>
        <p class="otp-note">It looks like you opened the sign-in link in a different browser. Confirm your email to finish signing in.</p>
        <p id="confirm-error" class="form-error" hidden></p>
        <form id="confirm-form" novalidate>
          <div class="field">
            <label for="confirm-email">Email</label>
            <input type="email" id="confirm-email" name="confirm-email" autocomplete="email" required />
          </div>
          <button type="submit">Continue</button>
        </form>
        <button type="button" id="confirm-back" class="link-btn">&larr; Request a new link</button>
      </div>

      <div id="step-checking" hidden>
        <p class="otp-note">Signing you in…</p>
      </div>

      <div id="step-denied" hidden>
        <p class="otp-note">That account doesn't have access to the admin area. If you think it should, contact <a href="mailto:dev@starterculturestudio.com">dev@starterculturestudio.com</a>.</p>
        <button type="button" id="denied-back" class="link-btn">&larr; Use a different email</button>
      </div>
    </div>
  </main>

  <p class="back-link"><a href="/">&larr; Back to home</a></p>

  <Footer />

  <script>
    import {
      isSignInWithEmailLink,
      onAuthStateChanged,
      sendSignInLinkToEmail,
      signInWithEmailLink,
      signOut,
      type User,
    } from 'firebase/auth';
    import { auth } from '../lib/firebase-config';

    // Remembers which email requested the link, so the callback can finish
    // sign-in without asking again (Firebase requires the email to match).
    const EMAIL_KEY = 'sc_company_signin_email';

    type Step = 'email' | 'sent' | 'confirm' | 'checking' | 'denied';
    const steps: Record<Step, HTMLDivElement | null> = {
      email: document.querySelector('#step-email'),
      sent: document.querySelector('#step-sent'),
      confirm: document.querySelector('#step-confirm'),
      checking: document.querySelector('#step-checking'),
      denied: document.querySelector('#step-denied'),
    };

    const form = document.querySelector<HTMLFormElement>('#company-login-form');
    const emailInput = document.querySelector<HTMLInputElement>('#company-email');
    const confirmForm = document.querySelector<HTMLFormElement>('#confirm-form');
    const confirmInput = document.querySelector<HTMLInputElement>('#confirm-email');
    const confirmError = document.querySelector<HTMLParagraphElement>('#confirm-error');

    function showStep(step: Step) {
      for (const [name, el] of Object.entries(steps)) {
        if (el) el.hidden = name !== step;
      }
    }

    function setBusy(f: HTMLFormElement | null, busy: boolean) {
      const btn = f?.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (btn) btn.disabled = busy;
    }

    // Staff go to the admin area; any other signed-in user (e.g. someone who
    // completed an email link without being granted the claim) is signed out.
    async function routeSignedInUser(user: User) {
      const { claims } = await user.getIdTokenResult();
      if (claims.staff === true) {
        window.location.href = '/company-admin';
        return;
      }
      await signOut(auth);
      showStep('denied');
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = emailInput?.value.trim() ?? '';
      if (!email) return;

      setBusy(form, true);
      try {
        await sendSignInLinkToEmail(auth, email, {
          url: `${window.location.origin}/company-login`,
          handleCodeInApp: true,
        });
        localStorage.setItem(EMAIL_KEY, email);
      } catch {
        // Still fall through to the generic "check your email" step: never
        // reveal whether an email belongs to a real team account.
      } finally {
        setBusy(form, false);
        showStep('sent');
      }
    });

    for (const id of ['#email-back', '#confirm-back', '#denied-back']) {
      document.querySelector(id)?.addEventListener('click', () => showStep('email'));
    }

    async function completeEmailLink(email: string) {
      showStep('checking');
      try {
        const { user } = await signInWithEmailLink(auth, email, window.location.href);
        localStorage.removeItem(EMAIL_KEY);
        history.replaceState(null, '', window.location.pathname);
        await routeSignedInUser(user);
      } catch {
        showStep('confirm');
        if (confirmError) {
          confirmError.textContent =
            "That link didn't work — it may have expired, or the email doesn't match. Request a new link.";
          confirmError.hidden = false;
        }
      }
    }

    confirmForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = confirmInput?.value.trim() ?? '';
      if (email) completeEmailLink(email);
    });

    if (isSignInWithEmailLink(auth, window.location.href)) {
      // Callback from the emailed link.
      const email = localStorage.getItem(EMAIL_KEY);
      if (email) {
        completeEmailLink(email);
      } else {
        showStep('confirm');
        confirmInput?.focus();
      }
    } else {
      // Already signed in as staff from an earlier visit? Skip straight ahead.
      // (Any other session, e.g. a client's, is left alone.)
      const unsubscribe = onAuthStateChanged(auth, async (user) => {
        unsubscribe();
        if (!user) return;
        const { claims } = await user.getIdTokenResult();
        if (claims.staff === true) window.location.href = '/company-admin';
      });
    }
  </script>
</Layout>
