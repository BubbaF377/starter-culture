---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/site.css';
---

<Layout
  title="Client Portal — StarterCulture"
  description="Your StarterCulture client project."
>
  <Header links={[{ href: '/', label: 'Home' }]} />

  <main class="auth-main">
    <div class="login-card portal-card">
      <p id="portal-loading">Loading your project…</p>

      <div id="portal-content" hidden>
        <span class="eyebrow" id="portal-client-id"></span>
        <h1 id="portal-project-name"></h1>
        <p id="portal-body"></p>
      </div>

      <p id="portal-error" class="form-error" hidden></p>

      <button type="button" id="portal-logout" class="link-btn" hidden>Log out</button>
    </div>
  </main>

  <p class="back-link"><a href="/">&larr; Back to home</a></p>

  <Footer />

  <script>
    import { onAuthStateChanged, signOut } from 'firebase/auth';
    import { doc, getDoc } from 'firebase/firestore';
    import { auth, db } from '../lib/firebase-config';

    const loading = document.querySelector<HTMLParagraphElement>('#portal-loading');
    const content = document.querySelector<HTMLDivElement>('#portal-content');
    const errorEl = document.querySelector<HTMLParagraphElement>('#portal-error');
    const logoutBtn = document.querySelector<HTMLButtonElement>('#portal-logout');
    const clientIdEl = document.querySelector<HTMLSpanElement>('#portal-client-id');
    const projectNameEl = document.querySelector<HTMLHeadingElement>('#portal-project-name');
    const bodyEl = document.querySelector<HTMLParagraphElement>('#portal-body');

    function showError(message: string) {
      if (loading) loading.hidden = true;
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.hidden = false;
      }
    }

    async function signOutAndRedirect() {
      await signOut(auth).catch(() => {});
      window.location.href = '/client-login';
    }

    logoutBtn?.addEventListener('click', signOutAndRedirect);

    // Fires once auth state is restored from storage (and again on sign-out,
    // which redirects anyway).
    onAuthStateChanged(auth, async (user) => {
      if (!user) {
        window.location.href = '/client-login';
        return;
      }

      const { claims } = await user.getIdTokenResult();
      const clientId = typeof claims.client_id === 'string' ? claims.client_id : '';
      if (!clientId) {
        // Signed in, but not as a client (e.g. a staff session in this browser).
        signOutAndRedirect();
        return;
      }

      try {
        const snap = await getDoc(doc(db, 'clients', clientId));
        if (!snap.exists()) {
          showError('Something went wrong loading your project. Please try again later.');
          return;
        }
        const client = snap.data();
        if (loading) loading.hidden = true;
        if (clientIdEl) clientIdEl.textContent = `Client ID: ${clientId}`;
        if (projectNameEl) projectNameEl.textContent = client.project_name;
        if (bodyEl) bodyEl.textContent = client.content;
        if (content) content.hidden = false;
        if (logoutBtn) logoutBtn.hidden = false;
      } catch (err) {
        // permission-denied means the 7-day session in firestore.rules has lapsed.
        if ((err as { code?: string }).code === 'permission-denied') {
          signOutAndRedirect();
          return;
        }
        showError("Couldn't reach the server. Check your connection and try again.");
      }
    });
  </script>
</Layout>

<style>
  .portal-card {
    text-align: left;
    max-width: 480px;
  }

  .portal-card #portal-loading {
    text-align: center;
    color: var(--brown-soft);
  }

  .portal-card h1 {
    font-family: Georgia, "Iowan Old Style", "Times New Roman", serif;
    font-weight: 500;
    font-size: 24px;
    margin: 0 0 12px;
  }

  .portal-card #portal-body {
    color: var(--brown-soft);
    font-size: 15px;
    margin: 0 0 20px;
  }
</style>
