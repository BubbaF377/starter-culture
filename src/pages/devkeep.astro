---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/site.css';

// Devkeep alpha-program page, in the site's own design system (see
// docs/PRODUCT.md item 6). The navy/gold badges are Devkeep's product marks,
// kept as-is the way the homepage's Devkeep card shows them.
const badges: Record<string, string> = {
  "Scribe": "<svg viewBox=\"0 0 140 140\"><rect width=\"140\" height=\"140\" rx=\"28\" fill=\"#23264D\"/><path d=\"M48,30.9 L24,70 L48,109.1\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M92,30.9 L116,70 L92,109.1\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M58,107 L82,107 L76,97 L73,95 L76,92 L76,91 L64,91 L64,92 L67,95 L64,97 Z\" fill=\"#D9A441\"/><ellipse cx=\"70\" cy=\"91\" rx=\"6\" ry=\"1.6\" fill=\"#23264D\"/><path d=\"M70,34 Q78,41 78,51 Q78,62 73,70 Q71,72 70,75 Q69,72 67,70 Q62,62 62,51 Q62,41 70,34 Z\" fill=\"#D9A441\"/><rect x=\"68.5\" y=\"75\" width=\"3\" height=\"16\" fill=\"#D9A441\"/></svg>",
  "Crypt": "<svg viewBox=\"0 0 140 140\"><rect width=\"140\" height=\"140\" rx=\"28\" fill=\"#23264D\"/><path d=\"M48,30.9 L24,70 L48,109.1\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M92,30.9 L116,70 L92,109.1\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"70\" cy=\"46.85\" r=\"12.86\" fill=\"#D9A441\"/><circle cx=\"70\" cy=\"46.85\" r=\"6.43\" fill=\"#23264D\"/><rect x=\"65.57\" y=\"54.57\" width=\"8.87\" height=\"51.44\" fill=\"#D9A441\"/><rect x=\"71.48\" y=\"88.00\" width=\"8.87\" height=\"3.86\" fill=\"#D9A441\"/><rect x=\"71.48\" y=\"95.08\" width=\"11.82\" height=\"3.86\" fill=\"#D9A441\"/><rect x=\"71.48\" y=\"102.15\" width=\"8.87\" height=\"3.86\" fill=\"#D9A441\"/></svg>",
  "Scout": "<svg viewBox=\"0 0 140 140\"><rect width=\"140\" height=\"140\" rx=\"28\" fill=\"#23264D\"/><path d=\"M48,30.9 L24,70 L48,109.1\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M92,30.9 L116,70 L92,109.1\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"70\" cy=\"37\" r=\"3.5\" fill=\"#D9A441\"/><rect x=\"67\" y=\"40\" width=\"6\" height=\"64\" fill=\"#D9A441\"/><path d=\"M73,49 L84,49 L90,55 L84,61 L73,61 Z\" fill=\"#D9A441\"/><path d=\"M67,68 L56,68 L50,74 L56,80 L67,80 Z\" fill=\"#D9A441\"/><rect x=\"64\" y=\"103\" width=\"12\" height=\"3\" fill=\"#D9A441\"/></svg>",
  "Seer": "<svg viewBox=\"0 0 140 140\"><rect width=\"140\" height=\"140\" rx=\"28\" fill=\"#23264D\"/><path d=\"M48,30.9 L24,70 L48,109.1\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M92,30.9 L116,70 L92,109.1\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><g stroke=\"#D9A441\" stroke-linecap=\"butt\"><g stroke-width=\"6\"><line x1=\"70\" y1=\"59.20\" x2=\"70\" y2=\"34.00\"/><line x1=\"70\" y1=\"80.80\" x2=\"70\" y2=\"106.00\"/></g><g stroke-width=\"3.6\"><line x1=\"63.10\" y1=\"59.20\" x2=\"57.58\" y2=\"50.80\"/><line x1=\"76.90\" y1=\"59.20\" x2=\"82.42\" y2=\"50.80\"/><line x1=\"57.58\" y1=\"62.80\" x2=\"49.30\" y2=\"55.60\"/><line x1=\"82.42\" y1=\"62.80\" x2=\"90.70\" y2=\"55.60\"/><line x1=\"63.10\" y1=\"80.80\" x2=\"57.58\" y2=\"89.20\"/><line x1=\"76.90\" y1=\"80.80\" x2=\"82.42\" y2=\"89.20\"/><line x1=\"57.58\" y1=\"77.20\" x2=\"49.30\" y2=\"84.40\"/><line x1=\"82.42\" y1=\"77.20\" x2=\"90.70\" y2=\"84.40\"/></g></g><path d=\"M50,70 Q70,40 90,70 Q70,100 50,70 Z\" fill=\"#23264D\" stroke=\"#D9A441\" stroke-width=\"3\"/><circle cx=\"70\" cy=\"70\" r=\"7\" fill=\"#D9A441\"/><circle cx=\"70\" cy=\"70\" r=\"3\" fill=\"#23264D\"/></svg>",
  "Judge": "<svg viewBox=\"0 0 140 140\"><rect width=\"140\" height=\"140\" rx=\"28\" fill=\"#23264D\"/><path d=\"M48,30.9 L24,70 L48,109.1\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M92,30.9 L116,70 L92,109.1\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"70\" cy=\"35.5\" r=\"3.5\" fill=\"#D9A441\"/><rect x=\"68.5\" y=\"39\" width=\"3\" height=\"5\" fill=\"#D9A441\"/><rect x=\"55\" y=\"44\" width=\"30\" height=\"3\" rx=\"1\" fill=\"#D9A441\"/><rect x=\"68\" y=\"47\" width=\"4\" height=\"48\" fill=\"#D9A441\"/><path d=\"M68,95 L72,95 L85,101 L55,101 Z\" fill=\"#D9A441\"/><rect x=\"55\" y=\"101\" width=\"30\" height=\"3\" rx=\"1\" fill=\"#D9A441\"/><line x1=\"55\" y1=\"47\" x2=\"49\" y2=\"60\" stroke=\"#D9A441\" stroke-width=\"2\" stroke-linecap=\"round\"/><line x1=\"55\" y1=\"47\" x2=\"61\" y2=\"60\" stroke=\"#D9A441\" stroke-width=\"2\" stroke-linecap=\"round\"/><path d=\"M48,60 Q55,68 62,60\" fill=\"none\" stroke=\"#D9A441\" stroke-width=\"2.5\" stroke-linecap=\"round\"/><line x1=\"85\" y1=\"47\" x2=\"79\" y2=\"60\" stroke=\"#D9A441\" stroke-width=\"2\" stroke-linecap=\"round\"/><line x1=\"85\" y1=\"47\" x2=\"91\" y2=\"60\" stroke=\"#D9A441\" stroke-width=\"2\" stroke-linecap=\"round\"/><path d=\"M78,60 Q85,68 92,60\" fill=\"none\" stroke=\"#D9A441\" stroke-width=\"2.5\" stroke-linecap=\"round\"/></svg>",
  "Ward": "<svg viewBox=\"0 0 140 140\"><rect width=\"140\" height=\"140\" rx=\"28\" fill=\"#23264D\"/><path d=\"M48,30.9 L24,70 L48,109.1\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M92,30.9 L116,70 L92,109.1\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M70,32.44 L77.20,54.98 L74.32,75.01 L65.68,75.01 L62.80,54.98 Z\" fill=\"#D9A441\"/><line x1=\"70\" y1=\"37.45\" x2=\"70\" y2=\"72.50\" stroke=\"#23264D\" stroke-width=\"1.5\"/><rect x=\"58.48\" y=\"75.01\" width=\"23.04\" height=\"4.38\" rx=\"1.2\" fill=\"#D9A441\"/><rect x=\"65.68\" y=\"79.39\" width=\"8.64\" height=\"16.28\" fill=\"#D9A441\"/><rect x=\"65.68\" y=\"87.53\" width=\"8.64\" height=\"1.63\" fill=\"#23264D\"/><circle cx=\"70\" cy=\"98.80\" r=\"5.63\" fill=\"#D9A441\"/></svg>",
  "Devkeep": "<svg viewBox=\"0 0 140 140\"><rect width=\"140\" height=\"140\" rx=\"28\" fill=\"#23264D\"/><path d=\"M48,30.9 L24,70 L48,109.1\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M92,30.9 L116,70 L92,109.1\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><rect x=\"60.34\" y=\"50.80\" width=\"19.32\" height=\"55.20\" fill=\"#D9A441\"/><rect x=\"60.34\" y=\"38.80\" width=\"4.14\" height=\"12.00\" fill=\"#D9A441\"/><rect x=\"67.93\" y=\"34.00\" width=\"4.14\" height=\"16.80\" fill=\"#D9A441\"/><rect x=\"75.52\" y=\"38.80\" width=\"4.14\" height=\"12.00\" fill=\"#D9A441\"/><rect x=\"67.93\" y=\"62.80\" width=\"4.14\" height=\"7.20\" fill=\"#23264D\"/></svg>"
};

const keepers = [
  {
    name: 'Scribe',
    tag: 'Every decision gets a record.',
    desc: 'Generates and maintains living documentation — architecture notes, decisions, requirements, release notes, and a QA test plan. A chat interface for asking your own codebase questions. Regenerates only what actually changed.',
  },
  {
    name: 'Crypt',
    tag: 'Every system has its secrets.',
    desc: 'Team secrets, APIs, URLs — all vault-backed and KMS-anchored, with real per-project access control. Not a shared .env file, not a random spreadsheet.',
  },
  {
    name: 'Scout',
    tag: 'Daily news from beyond the walls.',
    desc: 'A daily technical-reading digest scoped to your own stack — the one module that looks outward at the industry instead of inward at your repos. A chat interface to tune the results to your interests.',
  },
  {
    name: 'Seer',
    tag: 'The view from the throne.',
    desc: 'Team access management and a GitHub control board for account admins and owners. Keep an eye on access, releases, commits, and spend.',
  },
  {
    name: 'Judge',
    tag: 'The clearest view is from the outside in.',
    desc: 'An unattached outside auditor with zero prior context — explores a whole repo cold and produces a real, evidenced report, on demand.',
  },
  {
    name: 'Ward',
    tag: 'Nothing gets in unwatched.',
    desc: 'An ensemble of independent AI reviewers — each with its own mandate — evaluates every pull request before it merges, citing your own product doc while doing it.',
  },
];

const problems = [
  {
    label: 'Docs',
    title: "Your docs don't know when your code changes.",
    body: 'Nothing connects the wiki to the repo — so the page and the codebase drift apart, and nobody finds out until someone trusts the wrong one.',
  },
  {
    label: 'Secrets',
    title: "Your secrets don't know who's still on the team.",
    body: 'An API key set up in a spreadsheet three projects ago outlives the person who made it, because nothing connects your secrets to your roster.',
  },
  {
    label: 'Review',
    title: 'Your reviewer never saw the product doc.',
    body: 'A pull request can pass every check and still undo a decision made two months ago, because the review tool and the decision log have never talked.',
  },
  {
    label: 'Blind spots',
    title: 'Nothing independent ever looks at it twice.',
    body: 'The tool that wrote the code and the tool that reviewed it share the same context — and nothing in the stack exists to check either one from the outside.',
  },
];

const findings = [
  {
    verdict: 'Found & fixed',
    tone: 'warn',
    title: 'A vault write path with no real check on the destination',
    body: "Ward's security lens, reviewing a sibling module, caught a route that let any signed-in caller name which vault a write landed in — latent while one person runs one vault, live the moment it's shared. Fixed before it shipped to more than one person.",
  },
  {
    verdict: 'Sound with concerns',
    tone: 'good',
    title: "Judge's first cold read of an unfamiliar codebase",
    body: 'No prior context, no hand-holding — pointed at a repo it had never seen and asked to audit it the way an outside consultant would. It came back with 33 real, evidenced findings and an honest verdict, not a rubber stamp.',
  },
  {
    verdict: 'Found in the wild',
    tone: 'warn',
    title: 'A doc-parsing bug that made a module invisible to its own tools',
    body: 'A stray mention of a heading inside a sentence was enough to make the requirements parser stop at the wrong place — silently, and in the direction that looked like good news. Found through real use, not a spec review.',
  },
];
---

<Layout
  title="Devkeep Alpha Program — StarterCulture"
  description="Devkeep: one shell, one login, six purpose-built developer tools — all reading the same living product doc. Now looking for alpha testers."
>
  <Header links={[{ href: '/', label: 'Home' }]} />

  <main class="devkeep">

    <section class="hero wrap">
      <div class="hero-badge" aria-hidden="true" set:html={badges.Devkeep} />
      <span class="eyebrow">Alpha program — open now</span>
      <div class="hero-textblock">
        <div class="hero-brackets" aria-hidden="true">
          <svg viewBox="0 0 40 140" preserveAspectRatio="none"><path d="M32,10 L8,70 L32,130" /></svg>
          <svg viewBox="0 0 40 140" preserveAspectRatio="none"><path d="M8,10 L32,70 L8,130" /></svg>
        </div>
        <h1>Devkeep</h1>
        <p class="tagline">Your code is your kingdom. Every kingdom needs a keep.</p>
        <p class="lede">One shell, one login, six purpose-built tools — and a living document at the center that every one of them actually reads. We're looking for a few developers and QAs to put it through its paces before anyone else sees it.</p>
      </div>
      <p class="cue">↓ Scroll for the walkthrough</p>
    </section>

    <section class="alt">
      <div class="wrap">
        <div class="section-header">
          <span class="eyebrow">The problem</span>
          <h2>It's not a missing tool. It's tools that don't talk to each other.</h2>
          <p>Most of what slows a team down isn't any single broken thing — it's the seams between tools that weren't designed to know about each other.</p>
        </div>
        <div class="card-grid two">
          {problems.map((p) => (
            <div class="card">
              <div class="card-label">{p.label}</div>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="section-header">
          <span class="eyebrow">The idea</span>
          <h2>One keep. Six keepers. One set of keys.</h2>
          <p>Devkeep is one interface you open, not six tabs you juggle. Sign in once, link a project once, and call on whichever keeper you need — the way you'd call on any specialist on a team you already trust.</p>
        </div>
        <div class="rail" aria-hidden="true">
          {keepers.map((k) => (
            <div class="rail-item">
              <div class="badge" set:html={badges[k.name]} />
              <span>{k.name}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="alt">
      <div class="wrap">
        <div class="section-header">
          <span class="eyebrow">What makes it different</span>
          <h2>Every tool reads the same page.</h2>
          <p>At the center of every linked project is one file: <code>docs/PRODUCT.md</code> — a living record of numbered requirements and dated decisions, written by whomever owns the project. It's the thing Devkeep is built to read, and that Devkeep actively maintains.</p>
        </div>
        <figure class="diagram">
          <svg viewBox="0 0 760 280" role="img" aria-label="docs/PRODUCT.md feeding Scribe, Ward, and Judge">
            <g font-size="14">
              <path d="M340,130 C300,90 220,70 130,64" fill="none" stroke="var(--line-strong)" stroke-width="1.6"/>
              <path d="M380,130 L380,64" fill="none" stroke="var(--line-strong)" stroke-width="1.6"/>
              <path d="M420,130 C460,90 540,70 630,64" fill="none" stroke="var(--line-strong)" stroke-width="1.6"/>

              <rect x="300" y="130" width="160" height="66" rx="12" fill="var(--paper)" stroke="var(--terracotta)" stroke-width="1.6"/>
              <text x="380" y="158" text-anchor="middle" class="mono" fill="var(--brown)" font-weight="600">docs/</text>
              <text x="380" y="177" text-anchor="middle" class="mono" fill="var(--terracotta)" font-weight="600">PRODUCT.md</text>

              <rect x="50" y="18" width="160" height="46" rx="12" fill="var(--cream)" stroke="var(--line-strong)"/>
              <text x="130" y="46" text-anchor="middle" fill="var(--brown)" font-weight="600">Scribe</text>
              <text x="130" y="90" text-anchor="middle" class="halo" fill="var(--brown-soft)">regenerates only</text>
              <text x="130" y="107" text-anchor="middle" class="halo" fill="var(--brown-soft)">what changed</text>

              <rect x="300" y="18" width="160" height="46" rx="12" fill="var(--cream)" stroke="var(--line-strong)"/>
              <text x="380" y="46" text-anchor="middle" fill="var(--brown)" font-weight="600">Ward</text>
              <text x="380" y="90" text-anchor="middle" class="halo" fill="var(--brown-soft)">checks new code</text>
              <text x="380" y="107" text-anchor="middle" class="halo" fill="var(--brown-soft)">against the record</text>

              <rect x="550" y="18" width="160" height="46" rx="12" fill="var(--cream)" stroke="var(--line-strong)"/>
              <text x="630" y="46" text-anchor="middle" fill="var(--brown)" font-weight="600">Judge</text>
              <text x="630" y="90" text-anchor="middle" class="halo" fill="var(--brown-soft)">audits the whole repo</text>
              <text x="630" y="107" text-anchor="middle" class="halo" fill="var(--brown-soft)">against it, fresh</text>

              <text x="380" y="248" text-anchor="middle" fill="var(--brown-soft)" font-size="13">numbered requirements · dated decisions · one hash each</text>
            </g>
          </svg>
          <div class="diagram-list" aria-hidden="true">
            <div class="dl-doc"><span>docs/</span>PRODUCT.md</div>
            <ul>
              <li><strong>Scribe</strong> regenerates only what changed</li>
              <li><strong>Ward</strong> checks new code against the record</li>
              <li><strong>Judge</strong> audits the whole repo against it, fresh</li>
            </ul>
            <p class="dl-note">numbered requirements · dated decisions · one hash each</p>
          </div>
          <figcaption>A change to requirement #24 is a change one file makes — and every tool downstream sees it the same way.</figcaption>
        </figure>
      </div>
    </section>

    <section id="keepers">
      <div class="wrap">
        <div class="section-header">
          <span class="eyebrow">The six keepers</span>
          <h2>Meet the keepers.</h2>
        </div>
        <div class="card-grid three">
          {keepers.map((k) => (
            <div class="card">
              <div class="keeper-top">
                <div class="badge" aria-hidden="true" set:html={badges[k.name]} />
                <h3>{k.name}</h3>
              </div>
              <p class="keeper-tag">“{k.tag}”</p>
              <p>{k.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="alt">
      <div class="wrap">
        <div class="section-header">
          <span class="eyebrow">Proof, not promises</span>
          <h2>We didn't wait for testers to find the first bugs.</h2>
          <p>Ward and Judge have already been turned loose on Devkeep's own code — including on each other. A few of what they found, before anyone outside got a look:</p>
        </div>
        <div class="findings">
          {findings.map((f) => (
            <div class="card finding">
              <div class="finding-title-row">
                <h3>{f.title}</h3>
                <span class={`verdict ${f.tone}`}>{f.verdict}</span>
              </div>
              <p>{f.body}</p>
            </div>
          ))}
          <p class="findings-note">That's the level of scrutiny we want turned on your own repos next.</p>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="section-header">
          <span class="eyebrow">Who it's for</span>
          <h2>One requirement: your repos live on GitHub.</h2>
        </div>
        <div class="prose">
          <p>Devkeep scales down as easily as it scales up — a solo developer gets the same six tools a twelve-person team does, with nothing else to set up first.</p>
          <p>It's built for how code actually gets written now: alongside an AI coworker, not instead of one. Every linked project ships with instructions that keep those agents honest about documentation as they work — so moving fast doesn't mean losing track of why the code is the way it is.</p>
        </div>
      </div>
    </section>

    <section class="alt">
      <div class="wrap">
        <div class="section-header">
          <span class="eyebrow">The alpha</span>
          <h2>What we're asking, and what you get.</h2>
        </div>
        <div class="cols">
          <div class="card">
            <h3>What we're asking</h3>
            <ul>
              <li>Link a real project — or a throwaway one you don't mind poking at.</li>
              <li>Use it the way you'd actually use a tool, not a demo.</li>
              <li>Tell us what's confusing, what's broken, and what you didn't trust — the good notes and the blunt ones.</li>
              <li>QAs especially: try to break it. That's the point of an alpha.</li>
            </ul>
          </div>
          <div class="card">
            <h3>What you get</h3>
            <ul>
              <li>Full access to all six modules while they're free and still moving fast.</li>
              <li>A direct line to the person actually building it — not a support queue.</li>
              <li>A real say in what gets fixed and built next, while that's still cheap to change.</li>
              <li>An early, close look at how a product doc-driven suite like this actually holds up under real use.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="cta" id="join">
      <div class="wrap">
        <div class="cta-badge" aria-hidden="true" set:html={badges.Devkeep} />
        <h2>Help us find what we missed.</h2>
        <p class="lede">A handful of spots are open in this round. If you're a developer or QA who likes finding the seams in something new, we'd like your eyes on this before anyone else's.</p>
        <a class="btn btn-primary" href="mailto:dev@starterculturestudio.com?subject=Devkeep%20alpha%20—%20I%27m%20in">Email dev@starterculturestudio.com</a>
        <p class="tagline">Your code is your kingdom. Every kingdom needs a keep.</p>
        <p class="footnote">Devkeep · Alpha program · 2026</p>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  /* Page-only extension of the site palette: a slightly stronger rule for
     diagram lines/boxes, where --line alone is too faint to read. */
  .devkeep {
    --line-strong: rgba(43, 35, 32, 0.22);
    --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  }

  /* Alternating paper sections, as on the homepage's Studio/Contact. */
  section.alt {
    background: var(--paper);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  /* Hero -- same scale and hierarchy as the homepage hero */
  .hero {
    /* padding-block, not padding: the hero is also `.wrap`, which supplies
       the side padding. */
    padding-block: 96px 80px;
    text-align: center;
  }

  .hero-badge,
  .cta-badge {
    border-radius: 22%;
    overflow: hidden;
    margin: 0 auto 28px;
  }

  .hero-badge { width: 96px; height: 96px; }
  .cta-badge { width: 64px; height: 64px; margin-bottom: 20px; }

  .hero-badge :global(svg),
  .cta-badge :global(svg),
  .badge :global(svg) { width: 100%; height: 100%; display: block; }

  /* Devkeep's angle-bracket motif: large brackets flanking the hero text, and
     <...> around every section eyebrow (scoped -- other pages' eyebrows are
     untouched). */
  .hero-textblock {
    position: relative;
    max-width: 920px;
    margin: 0 auto;
    padding: 12px 0;
  }

  .hero-brackets {
    position: absolute;
    /* Extend past the text block so the brackets overhang the title above
       and the description below. */
    inset: -40px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
    opacity: 0.5;
  }

  .hero-brackets svg { height: 100%; max-height: 380px; width: auto; }

  .hero-brackets path {
    fill: none;
    stroke: var(--terracotta);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hero-textblock h1,
  .hero-textblock p { position: relative; }

  /* Narrower than the site .lede, for clear space between it and the brackets */
  .hero-textblock .lede { max-width: 520px; }

  .eyebrow::before,
  .eyebrow::after {
    font-family: var(--mono);
    font-weight: 500;
  }

  .eyebrow::before { content: "<"; margin-right: 8px; }
