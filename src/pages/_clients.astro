---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/site.css';
---

<Layout
  title="Client Portal — StarterCulture"
  description="StarterCulture client portal — sign in to see the status of your project. Coming soon."
>
  <Header links={[{ href: '/', label: 'Home' }]} />

  <main>
    <div class="login-card">
      <div class="lock-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#B5482B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="4" y="10" width="16" height="10" rx="2"/>
          <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
        </svg>
      </div>
      <h1>Client Portal</h1>
      <p class="sub">Sign in to see the status of what we're working on for you.</p>

      <span class="progress-badge">🚧 Coming soon — not yet active</span>

      <form id="wireframe-login" novalidate>
        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="you@company.com" disabled />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="••••••••" disabled />
        </div>
        <button type="submit" disabled>Log in</button>
      </form>
      <p id="login-note">Client accounts aren't set up yet — check back soon, or reach out at <a href="mailto:dev@starterculturestudio.com">dev@starterculturestudio.com</a> in the meantime.</p>
    </div>
  </main>

  <p class="back-link"><a href="/">&larr; Back to home</a></p>

  <Footer />
</Layout>

<style>
  main {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 64px 20px;
  }

  .login-card {
    width: 100%;
    max-width: 400px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 40px 36px;
    text-align: center;
  }

  .lock-icon {
    width: 52px;
    height: 52px;
    border-radius: 999px;
    background: var(--cream);
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
  }

  .lock-icon svg { width: 22px; height: 22px; }

  .login-card h1 {
    font-family: Georgia, "Iowan Old Style", "Times New Roman", serif;
    font-weight: 500;
    font-size: 26px;
    margin: 0 0 8px;
  }

  .login-card p.sub {
    color: var(--brown-soft);
    font-size: 15px;
    margin: 0 0 28px;
  }

  .progress-badge { margin-bottom: 28px; }

  form { text-align: left; }

  label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--brown-soft);
    margin-bottom: 6px;
  }

  .field { margin-bottom: 18px; }

  input {
    width: 100%;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--cream);
    color: var(--brown);
    font-size: 15px;
    font-family: inherit;
  }

  input::placeholder { color: rgba(43, 35, 32, 0.35); }

  input:disabled { cursor: not-allowed; opacity: 0.7; }

  button[type="submit"] {
    width: 100%;
    padding: 13px 26px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 600;
    border: none;
    background: var(--terracotta);
    color: var(--paper);
    cursor: not-allowed;
    opacity: 0.55;
    margin-top: 4px;
  }

  #login-note {
    margin-top: 16px;
    font-size: 13px;
    color: var(--brown-soft);
    text-align: center;
  }
</style>
