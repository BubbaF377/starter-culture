---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/site.css';
---

<Layout
  title="About — StarterCulture"
  description="About StarterCulture — the studio and the people behind it."
>
  <Header
    links={[
      { href: '/#products', label: 'Products' },
      { href: '/#contact', label: 'Contact' },
    ]}
  />

  <main>

    <section class="page-hero wrap">
      <span class="eyebrow">About</span>
      <h1>The studio, and the people behind it</h1>
      <p class="lede">StarterCulture is a small software development studio building AI-native products and AI-native software for the teams we work with.</p>
      <span class="progress-badge">🚧 Page in progress — team photos and bios coming soon</span>
    </section>

    <section id="company">
      <div class="wrap">
        <div class="section-header">
          <span class="eyebrow">The Company</span>
          <h2>Why StarterCulture</h2>
        </div>
        <p>We're a small studio that treats AI as a first-class collaborator from the very first line of code, not a feature bolted on afterward. That means smaller teams, faster decisions, and software that's built to last — for our own products, like Devlore, and for the teams we build with.</p>
      </div>
    </section>

    <section id="team">
      <div class="wrap">
        <div class="section-header">
          <span class="eyebrow">The Team</span>
          <h2>Who's behind it</h2>
          <p>Real bios and photos are coming — for now, here's the shape of it.</p>
        </div>

        <div class="team-grid">
          <div class="team-card">
            <div class="avatar-placeholder">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="4"/>
                <path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>
              </svg>
            </div>
            <h3>Christian Hankel</h3>
            <div class="role">Founder</div>
            <p class="bio">Bio coming soon.</p>
          </div>
          <div class="team-card placeholder-slot">
            <div class="avatar-placeholder">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="4"/>
                <path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>
              </svg>
            </div>
            <h3>Team Member</h3>
            <div class="role">Role TBD</div>
            <p class="bio">Bio coming soon.</p>
          </div>
          <div class="team-card placeholder-slot">
            <div class="avatar-placeholder">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="4"/>
                <path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>
              </svg>
            </div>
            <h3>Team Member</h3>
            <div class="role">Role TBD</div>
            <p class="bio">Bio coming soon.</p>
          </div>
        </div>
      </div>
    </section>

    <p class="back-link"><a href="/">&larr; Back to home</a></p>

  </main>

  <Footer />
</Layout>

<style>
  .page-hero {
    padding: 64px 0 24px;
    text-align: center;
  }

  h1 {
    font-family: Georgia, "Iowan Old Style", "Times New Roman", serif;
    font-weight: 500;
    font-size: clamp(30px, 5vw, 44px);
    line-height: 1.18;
    margin: 0 0 16px;
    letter-spacing: -0.01em;
  }

  .lede {
    font-size: 18px;
    color: var(--brown-soft);
    max-width: 620px;
    margin: 0 auto;
  }

  .progress-badge { margin: 28px auto 0; }

  #company {
    background: var(--paper);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  #company .wrap { max-width: 720px; }

  #company p {
    font-size: 17px;
    color: var(--brown-soft);
    text-align: center;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    max-width: 860px;
    margin: 0 auto;
  }

  .team-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px 24px;
    text-align: center;
  }

  .avatar-placeholder {
    width: 88px;
    height: 88px;
    border-radius: 999px;
    margin: 0 auto 18px;
    background: var(--cream);
    border: 1.5px dashed rgba(43, 35, 32, 0.28);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brown-soft);
  }

  .avatar-placeholder svg { width: 34px; height: 34px; }

  .team-card h3 {
    font-size: 17px;
    margin: 0 0 4px;
    font-weight: 600;
  }

  .team-card .role {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--terracotta);
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .team-card .bio {
    font-size: 14px;
    color: var(--brown-soft);
    font-style: italic;
  }

  .team-card.placeholder-slot {
    border-style: dashed;
    border-color: rgba(43, 35, 32, 0.22);
    background: transparent;
  }

  .team-card.placeholder-slot h3 { color: var(--brown-soft); }

  @media (max-width: 680px) {
    .team-grid { grid-template-columns: 1fr; gap: 20px; }
  }
</style>
