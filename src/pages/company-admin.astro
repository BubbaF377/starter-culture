---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/site.css';
---

<Layout
  title="Company Admin — StarterCulture"
  description="StarterCulture team admin area."
>
  <Header links={[{ href: '/', label: 'Home' }]} />

  <main class="admin-main">
    <div class="admin-header">
      <div>
        <h1>Company Admin</h1>
        <p class="sub" id="admin-whoami"></p>
      </div>
      <button type="button" id="logout-btn" class="link-btn">Log out</button>
    </div>

    <section class="admin-card">
      <h2>New client</h2>
      <p id="create-error" class="form-error" hidden></p>
      <p id="create-success" class="form-success" hidden></p>
      <form id="new-client-form" novalidate>
        <div class="field">
          <label for="client-name">Name</label>
          <input type="text" id="client-name" name="client-name" autocomplete="off" required />
        </div>
        <div class="field">
          <label for="client-email">Email</label>
          <input type="email" id="client-email" name="client-email" autocomplete="off" required />
        </div>
        <div class="field">
          <label for="client-phone">Phone (optional)</label>
          <input type="tel" id="client-phone" name="client-phone" autocomplete="off" />
        </div>
        <div class="field">
          <label for="client-project">Project name</label>
          <input type="text" id="client-project" name="client-project" autocomplete="off" required />
        </div>
        <button type="submit">Create client</button>
      </form>
    </section>

    <section class="admin-card">
      <h2>Clients</h2>
      <p id="list-error" class="form-error" hidden></p>
      <p id="list-empty" class="sub" hidden>No clients yet.</p>
      <div class="table-scroll">
      <table id="clients-table" hidden>
        <thead>
          <tr>
            <th>Client ID</th>
            <th>Name</th>
            <th>Project</th>
            <th>Created</th>
          </tr>
        </thead>
        <tbody id="clients-tbody"></tbody>
      </table>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    import { onAuthStateChanged, signOut } from 'firebase/auth';
    import {
      collection,
      doc,
      getDocs,
      orderBy,
      query,
      runTransaction,
      serverTimestamp,
      type Timestamp,
    } from 'firebase/firestore';
    import { auth, db } from '../lib/firebase-config';

    const PLACEHOLDER_CONTENT = "This is where we'll post information about your project.";

    const whoami = document.querySelector<HTMLParagraphElement>('#admin-whoami');

    document.querySelector<HTMLButtonElement>('#logout-btn')?.addEventListener('click', async () => {
      await signOut(auth).catch(() => {});
      window.location.href = '/company-login';
    });

    // Gate the page on the `staff` claim. firestore.rules enforce the same
    // check server-side; this just keeps non-staff from seeing an empty shell.
    const unsubscribe = onAuthStateChanged(auth, async (user) => {
      unsubscribe();
      if (!user) {
        window.location.href = '/company-login';
        return;
      }
      const { claims } = await user.getIdTokenResult();
      if (claims.staff !== true) {
        window.location.href = '/company-login';
        return;
      }
      if (whoami) whoami.textContent = `Logged in as ${user.email}`;
      loadClients();
    });

    function generateClientId(): string {
      const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
      const bytes = crypto.getRandomValues(new Uint8Array(6));
      return Array.from(bytes, (b) => chars[b % chars.length]).join('');
    }

    const tbody = document.querySelector<HTMLTableSectionElement>('#clients-tbody');
    const table = document.querySelector<HTMLTableElement>('#clients-table');
    const listEmpty = document.querySelector<HTMLParagraphElement>('#list-empty');
    const listError = document.querySelector<HTMLParagraphElement>('#list-error');

    async function loadClients() {
      try {
        const snap = await getDocs(query(collection(db, 'clients'), orderBy('created_at', 'desc')));

        if (tbody) tbody.replaceChildren();
        if (snap.empty) {
          if (listEmpty) listEmpty.hidden = false;
          if (table) table.hidden = true;
          return;
        }

        if (listEmpty) listEmpty.hidden = true;
        if (table) table.hidden = false;
        for (const clientDoc of snap.docs) {
          const client = clientDoc.data();
          const created = (client.created_at as Timestamp | null)?.toDate().toLocaleDateString() ?? '';
          const tr = document.createElement('tr');
          for (const value of [clientDoc.id, client.name, client.project_name, created]) {
            const td = document.createElement('td');
            td.textContent = value;
            tr.appendChild(td);
          }
          tbody?.appendChild(tr);
        }
      } catch {
        if (listError) {
          listError.hidden = false;
          listError.textContent = "Couldn't load the client list. Try refreshing the page.";
        }
      }
    }

    const form = document.querySelector<HTMLFormElement>('#new-client-form');
    const createError = document.querySelector<HTMLParagraphElement>('#create-error');
    const createSuccess = document.querySelector<HTMLParagraphElement>('#create-success');
    const nameInput = document.querySelector<HTMLInputElement>('#client-name');
    const emailInput = document.querySelector<HTMLInputElement>('#client-email');
    const phoneInput = document.querySelector<HTMLInputElement>('#client-phone');
    const projectInput = document.querySelector<HTMLInputElement>('#client-project');

    class ClientIdTaken extends Error {}

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (createError) createError.hidden = true;
      if (createSuccess) createSuccess.hidden = true;

      const name = nameInput?.value.trim() ?? '';
      const clientEmail = emailInput?.value.trim() ?? '';
      const phone = phoneInput?.value.trim() || null;
      const projectName = projectInput?.value.trim() ?? '';
      if (!name || !clientEmail || !projectName) return;

      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitBtn) submitBtn.disabled = true;

      // The doc ID is the Client ID. Create it in a transaction that fails if
      // the ID is already taken, and retry with a fresh one.
      const MAX_ATTEMPTS = 5;
      let createdId: string | null = null;
      let failed = false;

      for (let attempt = 0; attempt < MAX_ATTEMPTS && !createdId && !failed; attempt++) {
        const clientId = generateClientId();
        const ref = doc(db, 'clients', clientId);
        try {
          await runTransaction(db, async (tx) => {
            if ((await tx.get(ref)).exists()) throw new ClientIdTaken();
            tx.set(ref, {
              name,
              email: clientEmail,
              phone,
              project_name: projectName,
              content: PLACEHOLDER_CONTENT,
              created_at: serverTimestamp(),
            });
          });
          createdId = clientId;
        } catch (err) {
          if (!(err instanceof ClientIdTaken)) failed = true;
        }
      }

      if (submitBtn) submitBtn.disabled = false;

      if (createdId) {
        if (createSuccess) {
          createSuccess.hidden = false;
          createSuccess.textContent = `Client created — Client ID: ${createdId}. Share this with them so they can log in.`;
        }
        form.reset();
        loadClients();
      } else if (createError) {
        createError.hidden = false;
        createError.textContent = 'Something went wrong creating the client. Please try again.';
      }
    });
  </script>
</Layout>

<style>
  .admin-main {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding: 48px 20px;
  }

  .admin-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 32px;
  }

  .admin-header h1 {
    font-family: Georgia, "Iowan Old Style", "Times New Roman", serif;
    font-weight: 500;
    font-size: 28px;
    margin: 0 0 4px;
  }

  .admin-header {
    gap: 16px;
  }

  /* site.css only styles .link-btn inside .login-card */
  .admin-header .link-btn {
    flex-shrink: 0;
    margin-top: 8px;
    background: none;
    border: none;
    padding: 0;
    color: var(--brown-soft);
    font-size: 14px;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
  }

  .admin-header .link-btn:hover { color: var(--terracotta); }

  /* The 4-column client list scrolls sideways on phones instead of
     squashing or overflowing the card. */
  .table-scroll { overflow-x: auto; }
  .table-scroll table { min-width: 460px; }

  @media (max-width: 680px) {
    .admin-main { padding: 32px 20px; }
    .admin-card { padding: 22px; }
  }

  .admin-header .sub {
    color: var(--brown-soft);
    font-size: 14px;
    margin: 0;
  }

  .admin-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px;
    margin-bottom: 24px;
    text-align: left;
  }

  .admin-card h2 {
    font-family: Georgia, "Iowan Old Style", "Times New Roman", serif;
    font-weight: 500;
    font-size: 20px;
    margin: 0 0 20px;
  }

  .admin-card form {
    text-align: left;
  }

  .admin-card label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--brown-soft);
    margin-bottom: 6px;
  }

  .admin-card .field { margin-bottom: 16px; }

  .admin-card input {
    width: 100%;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--cream);
    color: var(--brown);
    font-size: 15px;
    font-family: inherit;
  }

  .admin-card button[type="submit"] {
    padding: 13px 26px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 600;
    border: none;
    background: var(--terracotta);
    color: var(--paper);
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .admin-card button[type="submit"]:hover { background: var(--terracotta-dark); }
  .admin-card button[type="submit"]:disabled { opacity: 0.6; cursor: not-allowed; }

  .form-success {
    font-size: 13px;
    color: #2f5c3f;
    background: rgba(47, 92, 63, 0.1);
    border-radius: 8px;
    padding: 10px 12px;
    margin: 0 0 16px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  th, td {
    text-align: left;
    padding: 10px 8px;
    border-bottom: 1px solid var(--line);
  }

  th {
    color: var(--brown-soft);
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
</style>
