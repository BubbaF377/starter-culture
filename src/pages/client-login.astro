---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/site.css';
---

<Layout
  title="Client Login — StarterCulture"
  description="Client login for StarterCulture — sign in to see working models, documentation, and other materials for your project."
>
  <Header links={[{ href: '/', label: 'Home' }]} />

  <main class="auth-main">
    <div class="login-card">
      <div class="lock-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#B5482B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="4" y="10" width="16" height="10" rx="2"/>
          <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
        </svg>
      </div>
      <h1>Client Login</h1>
      <p class="sub">This page is for StarterCulture clients. Log in here to see working models, documentation, and other materials for your project.</p>

      <div id="step-id">
        <p id="id-error" class="form-error" hidden></p>
        <form id="client-id-form" novalidate>
          <div class="field">
            <label for="client-id">Client ID</label>
            <input type="text" id="client-id" name="client-id" placeholder="e.g. A1B2C3" maxlength="6" autocomplete="off" autocapitalize="characters" required />
          </div>
          <button type="submit">Continue</button>
        </form>
      </div>

      <div id="step-otp" hidden>
        <p class="otp-note">We've sent a one-time passcode to the email on file for this Client ID. Enter it below to continue.</p>
        <p id="otp-error" class="form-error" hidden></p>
        <form id="otp-form" novalidate>
          <div class="field">
            <label for="otp">Passcode</label>
            <input type="text" id="otp" name="otp" placeholder="000000" maxlength="6" autocomplete="one-time-code" inputmode="numeric" required />
          </div>
          <button type="submit">Verify</button>
        </form>
        <button type="button" id="otp-back" class="link-btn">&larr; Use a different Client ID</button>
      </div>

      <p id="login-note">Don't have a Client ID? Reach out at <a href="mailto:dev@starterculturestudio.com">dev@starterculturestudio.com</a>.</p>
    </div>
  </main>

  <p class="back-link"><a href="/">&larr; Back to home</a></p>

  <Footer />

  <script>
    import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_FUNCTIONS_URL } from '../lib/supabase-config';

    const idForm = document.querySelector<HTMLFormElement>('#client-id-form');
    const otpForm = document.querySelector<HTMLFormElement>('#otp-form');
    const stepId = document.querySelector<HTMLDivElement>('#step-id');
    const stepOtp = document.querySelector<HTMLDivElement>('#step-otp');
    const backBtn = document.querySelector<HTMLButtonElement>('#otp-back');
    const idError = document.querySelector<HTMLParagraphElement>('#id-error');
    const otpError = document.querySelector<HTMLParagraphElement>('#otp-error');
    const clientIdInput = document.querySelector<HTMLInputElement>('#client-id');
    const otpInput = document.querySelector<HTMLInputElement>('#otp');

    let currentClientId = '';

    function setError(el: HTMLParagraphElement | null, message: string | null) {
      if (!el) return;
      if (message) {
        el.textContent = message;
        el.hidden = false;
      } else {
        el.hidden = true;
      }
    }

    function setBusy(form: HTMLFormElement | null, busy: boolean) {
      const btn = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (btn) btn.disabled = busy;
    }

    const OTP_VERIFY_ERRORS: Record<string, string> = {
      not_found: "That code doesn't match. Double-check it, or use a different Client ID to request a new one.",
      expired: 'That passcode has expired. Go back and request a new one.',
      too_many_attempts: 'Too many incorrect attempts. Go back and request a new passcode.',
      incorrect_code: 'Incorrect passcode. Please try again.',
      invalid_request: 'Something went wrong. Please try again.',
    };

    idForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      setError(idError, null);
      const clientId = clientIdInput?.value.trim().toUpperCase() ?? '';
      if (!/^[A-Z0-9]{6}$/.test(clientId)) {
        setError(idError, 'Client IDs are 6 characters (letters and numbers).');
        return;
      }

      setBusy(idForm, true);
      try {
        await fetch(`${SUPABASE_FUNCTIONS_URL}/client-otp-request`, {
          method: 'POST',
          headers: {
            Authorization: `Bearer ${SUPABASE_PUBLISHABLE_KEY}`,
            apikey: SUPABASE_PUBLISHABLE_KEY,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ client_id: clientId }),
        });
        currentClientId = clientId;
        if (stepId) stepId.hidden = true;
        if (stepOtp) stepOtp.hidden = false;
        otpInput?.focus();
      } catch {
        setError(idError, "Couldn't reach the server. Check your connection and try again.");
      } finally {
        setBusy(idForm, false);
      }
    });

    otpForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      setError(otpError, null);
      const code = otpInput?.value.trim() ?? '';
      if (!code) return;

      setBusy(otpForm, true);
      try {
        const res = await fetch(`${SUPABASE_FUNCTIONS_URL}/client-otp-verify`, {
          method: 'POST',
          headers: {
            Authorization: `Bearer ${SUPABASE_PUBLISHABLE_KEY}`,
            apikey: SUPABASE_PUBLISHABLE_KEY,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ client_id: currentClientId, code }),
        });
        const data = await res.json();

        if (data.ok && data.token) {
          localStorage.setItem(
            'sc_client_session',
            JSON.stringify({ client_id: currentClientId, token: data.token })
          );
          window.location.href = '/client-portal';
          return;
        }

        setError(otpError, OTP_VERIFY_ERRORS[data.error] ?? 'Something went wrong. Please try again.');
      } catch {
        setError(otpError, "Couldn't reach the server. Check your connection and try again.");
      } finally {
        setBusy(otpForm, false);
      }
    });

    backBtn?.addEventListener('click', () => {
      setError(otpError, null);
      if (otpInput) otpInput.value = '';
      if (stepOtp) stepOtp.hidden = true;
      if (stepId) stepId.hidden = false;
      clientIdInput?.focus();
    });
  </script>
</Layout>
